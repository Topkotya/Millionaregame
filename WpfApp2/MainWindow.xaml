
<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>

        <!-- Фон вопроса -->
        <Style x:Key="QuestionPanelStyle" TargetType="Grid">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="460"/>
        </Style>
        
        <LinearGradientBrush x:Key="AnswerBrush"
                     StartPoint="0,0"
                     EndPoint="0,1">

            <GradientStop Color="#111B8C" Offset="0"/>
            <GradientStop Color="#050653" Offset="1"/>

        </LinearGradientBrush>

        <!-- Кнопка ответа -->
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

    </Window.Resources>
    
    <Window.DataContext>
        <local:MainViewModel>

        </local:MainViewModel>
    </Window.DataContext>
    <Grid Width="821"
      Height="338">

        <!-- ФОН -->
        <Image Source="/pngtree-blue-fantasy-technology-background-material-backgroundpsd-backgroundadbackground-psdcreative-image_58500.png"
           Stretch="Fill"/>


        <!-- ВСЯ ВИКТОРИНА -->
        <Grid VerticalAlignment="Bottom"
          Margin="0,0,0,8">

            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <!-- вопрос -->

                <RowDefinition Height="30"/>
                <!-- A B -->

                <RowDefinition Height="30"/>
                <!-- C D -->

                <RowDefinition Height="32"/>
                <!-- номер вопроса -->
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- ВОПРОС -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
              Width="460"
              Height="50"
              HorizontalAlignment="Center">

                <!-- Форма -->
                <Path Stretch="Fill"
                  Fill="{StaticResource AnswerBrush}"
                  Stroke="#D9E7FF"
                  StrokeThickness="1.2"
                  Data="M 25,0
                        L 435,0
                        L 460,25
                        L 435,50
                        L 25,50
                        L 0,25
                        Z"/>

                <!-- Текст -->
                <TextBlock Text="{Binding QuestionText}"
                       Foreground="White"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="410"
                       Padding="5"/>

            </Grid>


            <!-- ================================================= -->
            <!-- ОТВЕТЫ -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
              Grid.RowSpan="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>


                <!-- A -->
                <Button Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource AnswerButtonStyle}"
                    Command="{Binding SubmitCommand}"
                    CommandParameter="{Binding Answer1}">

                    <Grid>

                        <Path Stretch="Fill"
                          Fill="{StaticResource AnswerBrush}"
                          Stroke="#D9E7FF"
                          StrokeThickness="1"
                          Data="M 15,0
                                L 215,0
                                L 230,15
                                L 215,30
                                L 15,30
                                L 0,15
                                Z"/>

                        <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="205">

                        <Run Text="A: "
                             Foreground="#FFE9D554"/>

                        <Run Text="{Binding Answer1}"
                             Foreground="White"/>

                        </TextBlock>

                    </Grid>

                </Button>


                <!-- B -->
                <Button Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource AnswerButtonStyle}"
                    Command="{Binding SubmitCommand}"
                    CommandParameter="{Binding Answer2}">

                    <Grid>

                        <Path Stretch="Fill"
                          Fill="{StaticResource AnswerBrush}"
                          Stroke="#D9E7FF"
                          StrokeThickness="1"
                          Data="M 15,0
                                L 215,0
                                L 230,15
                                L 215,30
                                L 15,30
                                L 0,15
                                Z"/>

                        <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="205">

                        <Run Text="B: "
                             Foreground="#FFE9D554"/>

                        <Run Text="{Binding Answer2}"
                             Foreground="White"/>

                        </TextBlock>

                    </Grid>

                </Button>


                <!-- C -->
                <Button Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource AnswerButtonStyle}"
                    Command="{Binding SubmitCommand}"
                    CommandParameter="{Binding Answer3}">

                    <Grid>

                        <Path Stretch="Fill"
                          Fill="{StaticResource AnswerBrush}"
                          Stroke="#D9E7FF"
                          StrokeThickness="1"
                          Data="M 15,0
                                L 215,0
                                L 230,15
                                L 215,30
                                L 15,30
                                L 0,15
                                Z"/>

                        <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="205">

                        <Run Text="C: "
                             Foreground="#FFE9D554"/>

                        <Run Text="{Binding Answer3}"
                             Foreground="White"/>

                        </TextBlock>

                    </Grid>

                </Button>


                <!-- D -->
                <Button Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource AnswerButtonStyle}"
                    Command="{Binding SubmitCommand}"
                    CommandParameter="{Binding Answer4}">

                    <Grid>

                        <Path Stretch="Fill"
                          Fill="{StaticResource AnswerBrush}"
                          Stroke="#D9E7FF"
                          StrokeThickness="1"
                          Data="M 15,0
                                L 215,0
                                L 230,15
                                L 215,30
                                L 15,30
                                L 0,15
                                Z"/>

                        <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="205">

                        <Run Text="D: "
                             Foreground="#FFE9D554"/>

                        <Run Text="{Binding Answer4}"
                             Foreground="White"/>

                        </TextBlock>

                    </Grid>

                </Button>

            </Grid>


            <!-- ================================================= -->
            <!-- НОМЕР ВОПРОСА -->
            <!-- ================================================= -->

            <Grid Grid.Row="3"
              Width="460"
              Height="32"
              HorizontalAlignment="Center">

                <Path Stretch="Fill"
                  Fill="{StaticResource AnswerBrush}"
                  Stroke="#D9E7FF"
                  StrokeThickness="1.2"
                  Data="M 25,0
                        L 435,0
                        L 460,16
                        L 435,32
                        L 25,32
                        L 0,16
                        Z"/>

                <TextBlock Text="{Binding PrintRound}"
                       Foreground="White"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            </Grid>

        </Grid>

    </Grid>
</Window>
