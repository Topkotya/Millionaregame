                             StretchDirection="DownOnly">

                                <TextBlock FontSize="20"
                                   Padding="0,0,100,0">
                            <Run Text="B: " Foreground="#FFE9D554"/>
                            <Run Text="{Binding Answer2}"
                                 Foreground="White"/>
                                </TextBlock>

                            </Viewbox>
                        </Button>

                        <Button Grid.Column="1"
                        Grid.Row="0"
                        Background="{Binding Answer3Background, TargetNullValue={StaticResource BlueGradient}}"
                        Margin="0"
                        Height="50"
                        Visibility="{Binding Answer3IsVisible}"
                        Template="{StaticResource MillionaireButtonTemplate}"
                        Command="{Binding SubmitCommand}"
                        CommandParameter="{Binding Answer3}">

                            <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly">

                                <TextBlock FontSize="20"
                                   Padding="0,0,100,0">
                                   <Run Text="C: " Foreground="#FFE9D554"/>
                                   <Run Text="{Binding Answer3}"
                                 Foreground="White"/>
                                </TextBlock>

                            </Viewbox>
                        </Button>

                        <Button Grid.Column="1"
