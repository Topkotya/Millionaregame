<Window x:Class="WpfApp2.MainWindow"                
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"        
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="800" MinWidth="1000" Height="800" Width="1000">
    
    <Window.Resources>
        
        <local:RewardBrushConverter x:Key="RewardBrushConverter"/>
        <local:VisibilityConverter x:Key="VisibilityConverter"/>
        
        <DataTemplate x:Key="GameplayTemplate">
            <local:GameplayView
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.gameplayViewModel}" />
        </DataTemplate>
        
        <DataTemplate x:Key="WinTemplate">
            <local:WinScreenView
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.winScreenViewModel}"/>
        </DataTemplate>
        
        <DataTemplate x:Key="LoseTemplate">
            <local:LoseScreenView 
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.loseScreenViewModel}"/>
        </DataTemplate>

        <local:GameStateTemplateSelector x:Key="GameStateSelector"
                                         GameplayTemplate="{StaticResource GameplayTemplate}"
                                         WinTemplate="{StaticResource WinTemplate}"
                                         LoseTemplate="{StaticResource LoseTemplate}" />
    </Window.Resources>

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <ContentControl Content="{Binding GameResult}" ContentTemplateSelector="{StaticResource GameStateSelector}"/>
    </Grid>
</Window>