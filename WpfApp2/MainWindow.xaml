<Window x:Class="WpfApp2.MainWindow"                
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="550" MinWidth="800" Height="550" Width="800">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <LinearGradientBrush x:Key="BlueGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#FF174EA6" Offset="0"/>
            <GradientStop Color="#FF0B2F78" Offset="0.5"/>
            <GradientStop Color="#FF061B4D" Offset="1"/>
        </LinearGradientBrush>
        <local:RewardBrushConverter x:Key="RewardBrushConverter"/>
        <local:VisibilityConverter x:Key="VisibilityConverter"/>
        <ControlTemplate x:Key="MillionaireButtonTemplate"
                 TargetType="Button">
            <Grid>
                <!-- Фон ромбовидной кнопки -->
                <Path Stretch="Fill"
                      Fill="{TemplateBinding Background}"
                      Stroke="#FFB8CFFF"
                      StrokeThickness="2"
                      Data="M 18,0 L 100,0 L 118,25 L 100,50 L 18,50 L 0,25 Z"/>

                <!-- Контент кнопки -->
                <ContentPresenter
                    Margin="20,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="MillionaireTextBoxTemplate"
                 TargetType="TextBox">

            <Grid>

                <!-- Ромбовидный фон -->
                <Path Stretch="Fill"
              Fill="{TemplateBinding Background}"
              Stroke="#FFB8CFFF"
              StrokeThickness="2">

                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="23,0">

                                <LineSegment Point="95,0"/>

                                <!-- Правый верх -->
                                <QuadraticBezierSegment
                            Point1="103,0"
                            Point2="108,7"/>

                                <QuadraticBezierSegment
                            Point1="115,17"
                            Point2="118,25"/>

                                <!-- Правый низ -->
                                <QuadraticBezierSegment
                            Point1="115,33"
                            Point2="108,43"/>

                                <QuadraticBezierSegment
                            Point1="103,50"
                            Point2="95,50"/>

                                <LineSegment Point="23,50"/>

                                <!-- Левый низ -->
                                <QuadraticBezierSegment
                            Point1="15,50"
                            Point2="10,43"/>

                                <QuadraticBezierSegment
                            Point1="3,33"
                            Point2="0,25"/>

                                <!-- Левый верх -->
                                <QuadraticBezierSegment
                            Point1="3,17"
                            Point2="10,7"/>

                                <QuadraticBezierSegment
                            Point1="15,0"
                            Point2="23,0"/>

                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <!-- Текст TextBox -->
                <ScrollViewer x:Name="PART_ContentHost"
                      Margin="15,0"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden"
                      VerticalAlignment="Center"/>

            </Grid>

        </ControlTemplate>

    </Window.Resources>

    <Grid>
        <Image Source="/Assets/pngtree-blue-fantasy-technology-background-material-backgroundpsd-backgroundadbackground-psdcreative-image_58500.png"
               Stretch="UniformToFill"/>

        <Viewbox Stretch="Uniform"
             StretchDirection="UpOnly"             
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="BooksListView"
                              Grid.Row="0"
                              ItemsSource="{Binding Rewards}"                              
                              BorderThickness="0"
                              Background="Transparent">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="10"
                    Margin="0,0,0,5"
                    Width="150"
                    Height="25"
                    Background="{Binding State, Converter={StaticResource RewardBrushConverter}, TargetNullValue={StaticResource BlueGradient}}"
                    Template="{StaticResource MillionaireButtonTemplate}">

                                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly">

                                    <TextBlock FontSize="20"
                               Padding="0,0,100,0">

                        <Run Text="📖 "
                             Foreground="#FFE9D554"/>

                        <Run Text="{Binding Reward}"
                             Foreground="White"/>

                                    </TextBlock>

                                </Viewbox>

                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                

                <Grid Margin="0,100, 40, 0" VerticalAlignment="Bottom" Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="2"
                     Foreground="White"
                     Background="{StaticResource BlueGradient}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Text="{Binding PrintRound}"
                     HorizontalAlignment="Center"                                          
                     Width="500"
                     Height="30"
                     TextAlignment="Center"
                     Margin="0,10,0,45"
                     Template="{StaticResource MillionaireTextBoxTemplate}"/>

                    <TextBox Grid.Row="0"
                 Foreground="White"
                 Background="{StaticResource BlueGradient}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Text="{Binding QuestionText}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Width="500"
                 Padding="40,0,40,0"
                 TextAlignment="Center"
                 Template="{StaticResource MillionaireTextBoxTemplate}"/>

                    <Grid Grid.Row="1"
                  HorizontalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Column="0"
                        Grid.Row="0"                        
                        Background="{Binding Answer1Background, TargetNullValue={StaticResource BlueGradient}}"
                        Margin="1"
                        Height="50"
                        Template="{StaticResource MillionaireButtonTemplate}"
                        Command="{Binding SubmitCommand}"
                        CommandParameter="{Binding Answer1}">

                            <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly">

                                <TextBlock FontSize="20"
                                   Padding="0,0,100,0">                            
                            <Run Text="A: " Foreground="#FFE9D554"/>
                            <Run Text="{Binding Answer1}"
                                 Foreground="White"/>
                                </TextBlock>

                            </Viewbox>
                        </Button>

                        <Button Grid.Column="0"
                        Grid.Row="1"
                        Background="{Binding Answer2Background, TargetNullValue={StaticResource BlueGradient}}"
                        Margin="0"
                        Height="50"
                        Template="{StaticResource MillionaireButtonTemplate}"
                        Command="{Binding SubmitCommand}"
                        CommandParameter="{Binding Answer2}">

                            <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly">

                                <TextBlock FontSize="20"
                                   Padding="0,0,100,0">
                            <Run Text="B: " Foreground="#FFE9D554"/>
                            <Run Text="{Binding Answer2}"
                                 Foreground="White"/>
                                </TextBlock>

                            </Viewbox>
                        </Button>

                        <Button Grid.Column="1"
                        Grid.Row="0"
                        Background="{Binding Answer3Background, TargetNullValue={StaticResource BlueGradient}}"
                        Margin="0"
                        Height="50"
                        Template="{StaticResource MillionaireButtonTemplate}"
                        Command="{Binding SubmitCommand}"
                        CommandParameter="{Binding Answer3}">

                            <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly">

                                <TextBlock FontSize="20"
                                   Padding="0,0,100,0">
                            <Run Text="C: " Foreground="#FFE9D554"/>
                            <Run Text="{Binding Answer3}"
                                 Foreground="White"/>
                                </TextBlock>

                            </Viewbox>
                        </Button>

                        <Button Grid.Column="1"
                        Grid.Row="1"
                        Background="{Binding Answer4Background, TargetNullValue={StaticResource BlueGradient}}"
                        Margin="1"
                        Height="50"
                        Template="{StaticResource MillionaireButtonTemplate}"
                        Command="{Binding SubmitCommand}"
                        CommandParameter="{Binding Answer4}">

                            <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly">

                                <TextBlock FontSize="20"
                                   Padding="0,0,100,0">
                            <Run Text="D: " Foreground="#FFE9D554"/>
                            <Run Text="{Binding Answer4}"
                                 Foreground="White"/>
                                </TextBlock>

                            </Viewbox>
                        </Button>

                    </Grid>

                </Grid>

            </Grid>

        </Viewbox>

        <!--экран победы-->
        <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding WinScreenState, Converter={StaticResource VisibilityConverter}}">

            <Grid Background="#FF061B4D" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock
                Text="Здесь могла быть ваша реклама"
                Foreground="White"
                FontSize="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            </Grid>
        </Viewbox>


        <!--экран поражения-->
        <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LoseScreenState, Converter={StaticResource VisibilityConverter}}">

            <Grid Background="#FF061B4D" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock
                Text="Здесь не могло быть вашей рекламы"
                Foreground="White"
                FontSize="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            </Grid>
        </Viewbox>
    </Grid>
</Window>