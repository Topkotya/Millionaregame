<Window x:Class="WpfApp2.MainWindow"                
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="800" MinWidth="1000" Height="800" Width="1000">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <LinearGradientBrush x:Key="BlueGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#FF174EA6" Offset="0"/>
            <GradientStop Color="#FF0B2F78" Offset="0.5"/>
            <GradientStop Color="#FF061B4D" Offset="1"/>
        </LinearGradientBrush>
        <local:RewardBrushConverter x:Key="RewardBrushConverter"/>
        <local:VisibilityConverter x:Key="VisibilityConverter"/>
        <ControlTemplate x:Key="MillionaireButtonTemplate"
                 TargetType="Button">
            <Grid>
                <!-- Фон ромбовидной кнопки -->
                <Path Stretch="Fill"
                      Fill="{TemplateBinding Background}"
                      Stroke="#FFB8CFFF"
                      StrokeThickness="2"
                      Data="M 18,0 L 100,0 L 118,25 L 100,50 L 18,50 L 0,25 Z"/>

                <!-- Контент кнопки -->
                <ContentPresenter
                    Margin="20,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="MillionaireTextBoxTemplate"
                 TargetType="TextBox">

            <Grid>

                <!-- Ромбовидный фон -->
                <Path Stretch="Fill"
              Fill="{TemplateBinding Background}"
              Stroke="#FFB8CFFF"
              StrokeThickness="2">

                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="23,0">

                                <LineSegment Point="95,0"/>

                                <!-- Правый верх -->
                                <QuadraticBezierSegment
                            Point1="103,0"
                            Point2="108,7"/>

                                <QuadraticBezierSegment
                            Point1="115,17"
                            Point2="118,25"/>

                                <!-- Правый низ -->
                                <QuadraticBezierSegment
                            Point1="115,33"
                            Point2="108,43"/>

                                <QuadraticBezierSegment
                            Point1="103,50"
                            Point2="95,50"/>

                                <LineSegment Point="23,50"/>

                                <!-- Левый низ -->
                                <QuadraticBezierSegment
                            Point1="15,50"
                            Point2="10,43"/>

                                <QuadraticBezierSegment
                            Point1="3,33"
                            Point2="0,25"/>

                                <!-- Левый верх -->
                                <QuadraticBezierSegment
                            Point1="3,17"
                            Point2="10,7"/>

                                <QuadraticBezierSegment
                            Point1="15,0"
                            Point2="23,0"/>

                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <!-- Текст TextBox -->
                <ScrollViewer x:Name="PART_ContentHost"
                      Margin="15,0"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden"
                      VerticalAlignment="Center"/>

            </Grid>

        </ControlTemplate>

    </Window.Resources>

    <Grid>
        <Image Source="/Assets/pngtree-blue-fantasy-technology-background-material-backgroundpsd-backgroundadbackground-psdcreative-image_58500.png"
               Stretch="UniformToFill"/>
        <Button Grid.Row="0"                                
                                VerticalAlignment="Top"
                                HorizontalAlignment="Center"                            
                                Margin="760,30,10,700"
                                Background="{Binding ErrorRightBackground, TargetNullValue={StaticResource BlueGradient}}"
                                Template="{StaticResource MillionaireButtonTemplate}"
                                Command="{Binding ErrorRightCommand}"
                                IsEnabled="{Binding ErrorRightAvailable}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <TextBlock FontSize="20">
                                        <Run Text="⚡ " Foreground="#FFE9D554"/>
                                        <Run Text="Право на ошибку" Foreground="White"/>
                </TextBlock>
            </Viewbox>
        </Button>
        
        <Button Grid.Row="0"                                
                                VerticalAlignment="Top"
                                HorizontalAlignment="Center"                            
                                Margin="560,30,240,700"
                                Background="{Binding FiftyFiftyBackground, TargetNullValue={StaticResource BlueGradient}}"
                                Template="{StaticResource MillionaireButtonTemplate}"
                                Command="{Binding FiftyFiftyCommand}"
                                IsEnabled="{Binding FiftyFiftyAvailable}">
            
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <TextBlock FontSize="20">                                        
                    <Run Text="50/50" Foreground="White"/>
                </TextBlock>
            </Viewbox>
        </Button>
        
        <Viewbox Stretch="Uniform"
             StretchDirection="UpOnly"             
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
        
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
        
                <ItemsControl x:Name="BooksListView"
                              Grid.Row="0"
                              ItemsSource="{Binding Rewards}"                              
                              BorderThickness="0"
                              Background="Transparent">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="10"
                                    Margin="0,0,0,5"                                    
                                    Width="150"
                                    Height="25"                                    
                                    Template="{StaticResource MillionaireButtonTemplate}">
                                
                                <Button.Style>
                                    <Style TargetType="Button">

                                        <!-- Базовая кисть, которую можно анимировать -->

                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <StaticResource ResourceKey="BlueGradient"/>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>
                                            <!-- CURRENT -->
                                            <DataTrigger Binding="{Binding State}" Value="Current">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                                            To="#FAB005"
                                                                            Duration="0:0:0.80">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>

                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                                            To="#FAB005"
                                                                            Duration="0:0:0.80">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>

                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[2].(GradientStop.Color)"
                                                                            To="#FAB005"
                                                                            Duration="0:0:0.80">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            
                                            <!-- COMPLETED -->
                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                                            To="#37C337"
                                                                            Duration="0:0:0.80"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                                            To="#37C337"
                                                                            Duration="0:0:0.80"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[2].(GradientStop.Color)"
                                                                            To="#37C337"                                                                            
                                                                            Duration="0:0:0.80"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>

                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock FontSize="20" Padding="0,0,100,0">
                                        <Run Text="📖 " Foreground="#FFE9D554"/>
                                        <Run Text="{Binding Reward}" Foreground="White"/>
                                    </TextBlock>
                                </Viewbox>

                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                

                <Grid Margin="0,100, 40, 0" VerticalAlignment="Bottom" Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="1" HorizontalAlignment="Center" ItemsSource="{Binding Answers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Width="400" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Button Background="{Binding Background, TargetNullValue={StaticResource BlueGradient}}"                                        
                                        Margin="1"
                                        Height="50"
                                        Visibility="{Binding Visability}"
                                        Template="{StaticResource MillionaireButtonTemplate}"
                                        Command="{Binding DataContext.SubmitCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Text}">

                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock FontSize="20" Padding="0,0,100,0">
                                            <Run Text="{Binding Letter}" Foreground="#FFE9D554" />
                                            <Run Text=": " Foreground="#FFE9D554" />
                                            <Run Text="{Binding Text}" Foreground="White" />
                                        </TextBlock>
                                    </Viewbox>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Grid.Row="2"
                             Foreground="White"
                             Background="{StaticResource BlueGradient}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Text="{Binding PrintRound}"
                             HorizontalAlignment="Center"                                          
                             Width="500"
                             Height="30"
                             TextAlignment="Center"
                             Margin="0,10,0,45"
                             Template="{StaticResource MillionaireTextBoxTemplate}"/>

                    <TextBox Grid.Row="0"
                 Foreground="White"
                 Background="{StaticResource BlueGradient}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Text="{Binding QuestionText}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Width="500"
                 Padding="40,0,40,0"
                 TextAlignment="Center"
                 Template="{StaticResource MillionaireTextBoxTemplate}"/>

                    <Grid Grid.Row="1"
                  HorizontalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>

                        <!--<Button Grid.Column="0"
                        Grid.Row="0"                        
                        Background="{Binding Answer1Background, TargetNullValue={StaticResource BlueGradient}}"
                        Margin="1"
                        Height="50"
