                             StretchDirection="DownOnly">

                                <TextBlock FontSize="20"
                                   Padding="0,0,100,0">
                            <Run Text="D: " Foreground="#FFE9D554"/>
                            <Run Text="{Binding Answer4}"
                                 Foreground="White"/>
                                </TextBlock>

                            </Viewbox>
                        </Button>-->

                    </Grid>
                    
                </Grid>

            </Grid>

        </Viewbox>

        <!--экран победы-->
        <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding WinScreenState, Converter={StaticResource VisibilityConverter}}">

            <Grid Background="#FF061B4D" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock
                Text="Здесь могла быть ваша реклама"
                Foreground="White"
                FontSize="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            </Grid>
        </Viewbox>


        <!--экран поражения-->
        <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LoseScreenState, Converter={StaticResource VisibilityConverter}}">

            <Grid Background="#FF061B4D" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock
                Text="Здесь не могло быть вашей рекламы"
                Foreground="White"
                FontSize="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            </Grid>
        </Viewbox>
    </Grid>
</Window>