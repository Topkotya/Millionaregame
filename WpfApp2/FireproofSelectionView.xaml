<UserControl x:Class="WpfApp2.FireproofSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfApp2"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="800">

    <Grid Background="{StaticResource BlueGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,30,0,10">
            <TextBlock Text="ВЫБЕРИТЕ НЕСГОРАЕМУЮ СУММУ"
                       Foreground="#FFE9D554"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock TextWrapping="Wrap"
                       MaxWidth="700"
                       TextAlignment="Center"
                       Margin="0,12,0,0"
                       Foreground="White"
                       FontSize="15"
                       Text="Если вы ошибётесь на любом вопросе после выбранного, то уйдёте с этой суммой. Ошибка на выбранном вопросе или раньше — и вы уходите ни с чем."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Options}" HorizontalAlignment="Center" Margin="0,10,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Width="620"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="46"
                                Margin="4,3"
                                Template="{StaticResource MillionaireButtonTemplate}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource BlueGradient}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource GoldGradient}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="#FFE9D554" FontSize="16">
                                    <Run Text="Вопрос "/>
                                    <Run Text="{Binding QuestionNumber}"/>
                                    <Run Text=" — "/>
                                </TextBlock>
                                <TextBlock Text="{Binding Reward}" Foreground="White" FontSize="16"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Начать игру"
                Width="220"
                Height="46"
                Margin="0,10,0,30"
                HorizontalAlignment="Center"
                FontSize="18"
                Foreground="White"
                Template="{StaticResource MillionaireButtonTemplate}"
                Background="{StaticResource GoldGradient}"
                Command="{Binding StartCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
