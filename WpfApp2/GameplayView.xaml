<!-- Views/GameplayView.xaml -->
<UserControl x:Class="WpfApp2.GameplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp2"
             mc:Ignorable="d"
                          
             d:DesignWidth="1000" d:DesignHeight="800">

    <Grid>
        <!-- Окно зрительского голосования -->

        <Image Source="/Assets/pngtree-blue-fantasy-technology-background-material-backgroundpsd-backgroundadbackground-psdcreative-image_58500.png"
               Stretch="UniformToFill"/>

        <StackPanel Panel.ZIndex="1">
            <Grid Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>



                <Button 
                    Grid.Row="2"
                    Grid.Column="2"                
                    Opacity="{Binding FriendCallHint.Opacity, TargetNullValue= 1.0}"
                    Background="{Binding FriendCallHint.FriendCallBackground, TargetNullValue={StaticResource BlueGradient}}"
                    Template="{StaticResource MillionaireButtonTemplate}"
                    Command="{Binding FriendCallHint.FriendCallHelpCommand}"
                    IsEnabled="{Binding FriendCallHint.IsEnabled}">

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock FontSize="20">
                            <Run Text="" Foreground="#FFE9D554"/>
                            <Run Text="Звонок другу" Foreground="White"/>
                        </TextBlock>
                    </Viewbox>
                </Button>

                <Button 
                    Grid.Row="0"
                    Grid.Column="0"                
                    Opacity="{Binding AudienceHelpHint.Opacity, TargetNullValue= 1.0}"
                    Background="{Binding AudienceHelpHint.AudienceHelpBackground, TargetNullValue={StaticResource BlueGradient}}"
                    Template="{StaticResource MillionaireButtonTemplate}"
                    Command="{Binding AudienceHelpHint.AudienceHelpCommand}"
                    IsEnabled="{Binding AudienceHelpHint.IsEnabled}">

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock FontSize="20">
                            <Run Text="👥 " Foreground="#FFE9D554"/>
                            <Run Text="Помощь зала" Foreground="White"/>    
                        </TextBlock>
                    </Viewbox>
                </Button>

                <Button 
                    Grid.Row="0"
                    Grid.Column="2"
                    Opacity="{Binding ErrorRightHint.Opacity, TargetNullValue = 1.0}"
                    Background="{Binding ErrorRightHint.ErrorRightBackground, TargetNullValue={StaticResource BlueGradient}}"
                    Template="{StaticResource MillionaireButtonTemplate}"
                    Command="{Binding ErrorRightHint.ErrorRightCommand}"
                    IsEnabled="{Binding ErrorRightHint.IsEnabled}">

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock FontSize="20">
                            <Run Text="⚡ " Foreground="#FFE9D554"/>
                            <Run Text="Право на ошибку" Foreground="White"/>
                        </TextBlock>
                    </Viewbox>
                </Button>

                <Button 
                    Grid.Row="2"
                    Grid.Column="0"
                    Opacity="{Binding FiftyFiftyHint.Opacity, TargetNullValue = 1.0}"
                    Background="{Binding FiftyFiftyHint.FiftyFiftyBackground, TargetNullValue={StaticResource BlueGradient}}"
                    Template="{StaticResource MillionaireButtonTemplate}"
                    Command="{Binding FiftyFiftyHint.FiftyFiftyCommand}"
                    IsEnabled="{Binding FiftyFiftyHint.IsEnabled}">

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock FontSize="20">                                        
                            <Run Text="50/50" Foreground="White"/>
                        </TextBlock>
                    </Viewbox>
                </Button>
            </Grid>

            <Border Width="600" 
                Height="Auto"                           
                MinHeight="40"
                Visibility="{Binding FriendCallVisibility, TargetNullValue = Hidden}"
                BorderBrush="#FFFFFF"
                Background="#000000"
                Margin="220,20,0,0"
                Padding="8"                
                CornerRadius="20" 
                BorderThickness="3"
                Grid.Row="2"
                Grid.Column="2">
                
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding TextLineItems}"                              
                              BorderThickness="0"
                              Background="Transparent">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text = "{Binding Text}"
                                       FontSize="16"
                                       Margin="0,0,0,5"
                                       Foreground = "{Binding TextColor}"                                       
                             >
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
            </Border>
        </StackPanel>
        


        <Viewbox Stretch="Uniform"
                 StretchDirection="UpOnly"             
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="BooksListew"
                              Grid.Row="0"
                              ItemsSource="{Binding Rewards}"                              
                              BorderThickness="0"
                              Background="Transparent">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="10"
                                    Margin="0,0,0,5"                                    
                                    Width="150"
                                    Height="25"                                    
                                    Template="{StaticResource MillionaireButtonTemplate}">

                                <Button.Style>
                                    <Style TargetType="Button">

                                        <!-- Базовая кисть, которую можно анимировать -->

                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <StaticResource ResourceKey="BlueGradient"/>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>
                                            <!-- CURRENT -->
                                            <DataTrigger Binding="{Binding State}" Value="Current">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                                            To="#FAB005"
                                                                            Duration="0:0:0.80">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>

                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                                            To="#FAB005"
                                                                            Duration="0:0:0.80">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>

                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[2].(GradientStop.Color)"
                                                                            To="#FAB005"
                                                                            Duration="0:0:0.80">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>

                                            <!-- COMPLETED -->
                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                                            To="#37C337"
                                                                            Duration="0:0:0.80"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                                            To="#37C337"
                                                                            Duration="0:0:0.80"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[2].(GradientStop.Color)"
                                                                            To="#37C337"                                                                            
                                                                            Duration="0:0:0.80"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>

                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock FontSize="20" Padding="0,0,100,0">
                                        <Run Text="📖 " Foreground="#FFE9D554"/>
                                        <Run Text="{Binding Reward}" Foreground="White"/>
                                    </TextBlock>
                                </Viewbox>

                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,100, 40, 0" VerticalAlignment="Bottom" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="3"></Grid>

                    <ItemsControl Grid.Row="1" HorizontalAlignment="Center" ItemsSource="{Binding Answers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Width="400" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="{Binding Background, TargetNullValue={StaticResource BlueGradient}}"                                        
                                        Margin="1"
                                        Height="50"
                                        IsEnabled="{Binding IsEnabled}"
                                        Visibility="{Binding Visability}"
                                        Template="{StaticResource MillionaireButtonTemplate}"
                                        Command="{Binding DataContext.SubmitCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Text}">


                                    <TextBlock FontSize="13" Padding="0,0,100,0">
                                            <Run Text="{Binding Letter}" Foreground="#FFE9D554" />
                                            <Run Text=": " Foreground="#FFE9D554" />
                                            <Run Text="{Binding Text}" Foreground="White" />
                                    </TextBlock>

                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Grid.Row="2"
                             Foreground="White"
                             Background="{StaticResource BlueGradient}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Text="{Binding PrintRound}"
                             HorizontalAlignment="Center"                                          
                             Width="500"
                             Height="30"
                             TextAlignment="Center"
                             Margin="0,10,0,45"
                             Template="{StaticResource MillionaireTextBoxTemplate}"/>

                    <TextBox Grid.Row="0"
                             Foreground="White"
                             Background="{StaticResource BlueGradient}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Text="{Binding QuestionText}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Width="500"
                             Padding="40,0,40,0"
                             TextAlignment="Center"
                             Template="{StaticResource MillionaireTextBoxTemplate}"/>

                    <Grid Grid.Row="1"
                          HorizontalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>

        <Grid Visibility="{Binding AudienceVoteVisibility, TargetNullValue = Hidden}" Background="#CC020817" Panel.ZIndex="-1">
            <Border Width="650" Height="450" Padding="25" CornerRadius="20" BorderThickness="3"
                    BorderBrush="#FFE9D554"
                    Background="#FF071C4A"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0"
                               Text="ЗРИТЕЛЬСКОЕ ГОЛОСОВАНИЕ"
                               Foreground="#FFE9D554"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,20"/>

                    <!-- Столбцы -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding AudienceVotes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Диаграмма -->
                                    <Grid Grid.Row="0"
                                          VerticalAlignment="Bottom"
                                          Height="240"
                                          Width="90">
                                        <Border Background="#FF142F60" CornerRadius="8"/>
                                        <Border Background="{Binding BarColor}" CornerRadius="8" VerticalAlignment="Bottom" Height="{Binding BarHeight}"/>
                                    </Grid>

                                    <!-- Процент голосов -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Percent, StringFormat={}{0}%}"
                                               Foreground="White"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,5"/>

                                    <!-- Буква ответа -->
                                    <Border Grid.Row="2"
                                    Background="#FF123C78"
                                    CornerRadius="8"
                                    Padding="15,8"
                                    Margin="0,5">
                                        <TextBlock Text="{Binding Letter}"
                                           Foreground="#FFE9D554"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Закрытие -->
                    <Button 
                        Grid.Row="2" Content="Продолжить" Width="180" Height="40"
                        Margin="0,15,0,0" HorizontalAlignment="Center" Template="{StaticResource MillionaireButtonTemplate}"
                        Command="{Binding CloseAudienceVoteCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>